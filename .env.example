# LLM Providers (Configure at least one for live LLM mode)
GOOGLE_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash-lite"

ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-3-5-sonnet-20241022"

# Decision Mode (Default: llm; fallback: rules)
DECISION_MODE="llm"

# Privacy & Document Vault (Fernet symmetric key)
VAULT_KEY=""

# Notifications & Approvals
NOTIFY_DRY_RUN="true"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
TELEGRAM_BOT_TOKEN=""

# Embeddings & Vector Store
EMBEDDING_PROVIDER="default"
CHROMA_COLLECTION_NAME="government_schemes"

# Agent Execution
MAX_PLANNER_STEPS="8"
CONFIDENCE_THRESHOLD="0.7"
DEFAULT_LANGUAGE="en"
